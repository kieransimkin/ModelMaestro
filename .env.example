# Copy to .env. The launcher reads this file; existing environment values win.
HOST=127.0.0.1
PORT=3000
BACKEND_PORT=8765
APP_ORIGIN=http://127.0.0.1:3000
# Set a long secret, or a private .state/access-token is generated automatically.
# APP_TOKEN=
# APP_STATE_DIR=/fast-ssd/modelmaestro
AUTO_INSTALL=1
# First successful install resolves and records a commit; restarts do not update it.
OLLM_REPO=https://github.com/kieransimkin/ollm.git
OLLM_REF=b395639e7397573728c7c4a1f82565ef1cb542c4
LLAMA_REF=latest
# auto uses CUDA when nvcc is present, Metal on Apple Silicon, otherwise CPU.
LLAMA_ACCELERATOR=auto
LLAMA_BUILD_JOBS=2
# OLLM_DEVICE=cuda:0
# OLLM_CPU_LAYERS=0
# OLLM_CUDA_MEMORY_FRACTION=0.90
# Install hardware-specific optional acceleration explicitly through Runtimes.
# HF_TOKEN=hf_...
# Ollm's baseline dependencies are installed without mandatory FlashAttention.
# OLLM_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# Explicit, operator-controlled network hosts allowed for remote MCP servers.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.example.com
# MCP server environment configuration references names below, never raw secrets.
# BRAVE_API_KEY=...
# Set to 1 only for the deterministic, clearly labelled integration-test backend.
DEMO_MODE=0
